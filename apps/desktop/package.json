{
  "name": "@monaddesign/client",
  "version": "0.0.0",
  "build": {
    "appId": "design.mona.client",
    "productName": "Monad Design",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "licenses/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../core/dist/monad-design",
        "to": "core/monad-design"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@monaddesign/client-contract": "workspace:*",
    "@monaddesign/client-rtk": "workspace:*",
    "@monaddesign/core": "workspace:*",
    "@monaddesign/core-installation": "workspace:*",
    "@monaddesign/device-frame": "workspace:*",
    "@monaddesign/pairing": "workspace:*",
    "@monaddesign/simulator": "workspace:*",
    "@monaddesign/simulator-history": "workspace:*",
    "@monaddesign/state": "workspace:*",
    "@monaddesign/ui": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "26.15.3",
    "rolldown": "1.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "dev": "vite",
    "dist": "bun run --cwd ../core build && electron-builder --mac",
    "lint": "biome lint .",
    "package": "bun run --cwd ../core build && electron-builder --mac dir",
    "test": "bun test test",
    "test:e2e": "bun test test/e2e",
    "test:unit": "bun test test/unit",
    "typecheck": "tsc -b --pretty false"
  },
  "type": "module"
}
