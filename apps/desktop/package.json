{
  "name": "@monaddesign/client",
  "version": "0.1.0",
  "build": {
    "npmRebuild": false,
    "afterPack": "./scripts/after-pack.cjs",
    "appId": "ai.monadix.design",
    "productName": "Monad Design",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "licenses/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist-installer",
        "to": "installer"
      }
    ],
    "mac": {
      "signIgnore": [
        "Contents/Resources/installer/core/.*"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "icon": "build/icon.icon",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@monaddesign/agent-integration": "workspace:*",
    "@monaddesign/client-contract": "workspace:*",
    "@monaddesign/client-rtk": "workspace:*",
    "@monaddesign/core": "workspace:*",
    "@monaddesign/core-installation": "workspace:*",
    "@monaddesign/device-frame": "workspace:*",
    "@monaddesign/pairing": "workspace:*",
    "@monaddesign/simulator": "workspace:*",
    "@monaddesign/simulator-history": "workspace:*",
    "@monaddesign/state": "workspace:*",
    "@monaddesign/ui": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "motion": "^13.4.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "26.15.3",
    "rolldown": "1.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "dev": "vite",
    "dist": "bun run build && bun run --cwd ../core build && bun run prepare:installer && electron-builder --mac",
    "dist:arm64": "MONAD_DESIGN_DESKTOP_ARCH=arm64 bun run dist -- --arm64",
    "dist:x64": "MONAD_DESIGN_DESKTOP_ARCH=x64 bun run dist -- --x64",
    "lint": "biome lint .",
    "package": "bun run build && bun run --cwd ../core build && bun run prepare:installer && electron-builder --mac dir",
    "prepare:installer": "bun run scripts/prepare-installer.ts",
    "test": "bun test test",
    "test:e2e": "bun test test/e2e",
    "test:unit": "bun test test/unit",
    "typecheck": "tsc -b --pretty false",
    "verify:release": "bun run scripts/verify-release.ts"
  },
  "type": "module"
}
