{
  "name": "monad-design",
  "description": "Install Monad Design Core and connect it to local coding agents.",
  "version": "0.0.7",
  "bin": {
    "monad-design": "dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/Monadix-AI/monad-design/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "add-mcp": "2.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@monaddesign/client-rtk": "workspace:*",
    "@monaddesign/core": "workspace:*",
    "@monaddesign/core-installation": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/Monadix-AI/monad-design#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "ios",
    "mcp",
    "simulator"
  ],
  "license": "Apache-2.0",
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monadix-AI/monad-design.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "tsc --noEmit --pretty false",
    "lint": "biome lint .",
    "prepack": "bun run verify:release",
    "test": "bun test test",
    "test:unit": "bun test test/unit",
    "typecheck": "tsc --noEmit --pretty false",
    "verify:release": "bun run scripts/verify-release.ts"
  },
  "type": "module"
