{
  "expo": {
    "name": "Monad Design",
    "slug": "monad-design",
    "scheme": "monaddesign",
    "version": "0.0.1",
    "platforms": ["ios"],
    "orientation": "landscape",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "2",
      "icon": {
        "light": "./assets/icons/light.png",
        "dark": "./assets/icons/dark.png",
        "tinted": "./assets/icons/tinted.png"
      },
      "supportsTablet": true,
      "isTabletOnly": true,
      "requireFullScreen": true,
      "bundleIdentifier": "ai.monadix.design",
      "appleTeamId": "J6WWXL6B6P",
      "infoPlist": {
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSLocalNetworkUsageDescription": "Monad Design connects to the Client running on your Mac to inspect and control local iOS Simulators.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Monad Design to scan a pairing code shown on your Mac."
        }
      ]
    ]
  }
}
