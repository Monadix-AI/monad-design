{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "MONAD_DESIGN_BUN_PATH",
    "MONAD_DESIGN_CORE_BOOTSTRAP_PATH",
    "MONAD_DESIGN_CORE_HOST",
    "MONAD_DESIGN_CORE_PORT",
    "MONAD_DESIGN_CORE_STATE_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
